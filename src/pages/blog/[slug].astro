---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { formatDate } from '../../data/format-date';
import { handle } from '../../data/profile';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | ${handle}`} description={post.data.description}>
  <a class="btn btn-text btn-sm ripple focus-ring-outer" href="/blog/">
    <Icon name="arrow_back" />
    Blog
  </a>
  <article class="section prose">
    <h1>{post.data.title}</h1>
    <p><time datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time></p>
    <Content />
  </article>
</BaseLayout>
